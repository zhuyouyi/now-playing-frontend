{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Now Playing",
  "version": "2.1.5",
  "identifier": "com.widdit.nowplaying",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Now Playing",
        "url": "http://localhost:9863",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}
